includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # A ratchet for new code, not a mandate to rewrite the package. Everything
    # the level cannot see today sits in the baseline and has to shrink, never
    # grow.
    level: 5

    paths:
        - src
        - database
        - config
        - routes

    # The activity bridge references classes from an optional sibling addon
    # (`suggest`, guarded by class_exists). Those classes are legitimately absent
    # in a bare install, so analysing the file would report every reference as
    # unknown.
    excludePaths:
        - src/Bridges/ActivityBridge.php

    # The analytics addon is a `suggest`, not a `require`: the metrics under
    # src/Integrations/Insights extend its TableMetric and it is not in vendor.
    # Scanned from the test stand-in — the same declarations, byte for byte —
    # so the metrics are checked against the real signatures instead of being
    # reported as unknown classes. Scanned, not analysed: the file is not code
    # this package ships.
    scanFiles:
        - tests/Fakes/insights-contracts.php
        - tests/Fakes/insights-table-metric.php

    treatPhpDocTypesAsCertain: false
