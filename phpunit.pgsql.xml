<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same suite, against a real Postgres server.

        vendor/bin/pest -c phpunit.pgsql.xml

    Added with the limit counters. Their guarantee is that two bookings on the
    last slot cannot both succeed, and that guarantee lives in the engine: a
    conditional UPDATE on one row and an INSERT that yields to a unique index.
    Postgres differs from MySQL in the way that matters here (a failed statement
    poisons the whole transaction), so both engines race the real thing in
    tests/Feature/Limits/ConcurrentConsumeTest.php.

    The env values below are defaults; CI and local runs override them.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_TIMEZONE" value="America/Chicago"/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="DB_DRIVER" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="entitlements_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="BRAND_CONTEXT_MULTI_BRAND" value="false"/>
    </php>
</phpunit>
